# Fresh Supermart - Environment Configuration
# Copy this file to .env and provide your production gateway credentials.
# NEVER commit real API keys, secrets, or passwords to version control.

PORT=3000
NODE_ENV=production

# Store UPI Details
STORE_NAME=Fresh Supermart
UPI_MERCHANT_VPA=freshsupermart@okaxis
UPI_MERCHANT_NAME=Fresh Supermart Retail

# Payment Gateway (Razorpay / Cashfree / PhonePe / Paytm)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=rzp_live_placeholder_key_id
PAYMENT_GATEWAY_KEY_SECRET=placeholder_secret_key_never_share
PAYMENT_WEBHOOK_SECRET=placeholder_webhook_signature_secret

# Testing & Sandbox Mode
# Set to 'false' in strict production to disable client-side sandbox simulation
ENABLE_MOCK_PAYMENT_SANDBOX=true
